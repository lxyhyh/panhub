<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      传输要在退到后台后继续跑，所以用前台服务。
      Android 13 起通知要用户授权；没授权时服务仍能跑，只是通知不显示，
      系统依然按前台服务给进程提优先级。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".PanHubApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PanHub">

        <!--
          launchMode=singleTop：从别的应用分享过来时，如果 PanHub 已经开着，
          就复用那个实例走 onNewIntent，而不是再叠一个 MainActivity
          （否则返回键要先退掉一层空壳才回到原来的页面）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PanHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              从网盘 App / 聊天软件的「分享」菜单进来。
              只收纯文本：网盘链接在那些应用里都是文本形式，
              收图片或文件我们也没办法直接存进网盘。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 传输前台服务：只在队列里有活的时候启动，传完自己停。 -->
        <service
            android:name=".transfer.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          下载的文件落在应用私有目录，其他应用访问不到。
          要用系统播放器/查看器打开或分享出去，必须经由 FileProvider
          临时授权；只暴露 downloads 子目录，不是整个 filesDir。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>